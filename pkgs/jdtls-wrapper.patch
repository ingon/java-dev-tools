+// Replace read-only cached sources atomically, including on repeated navigation.
+func writeSource(path, content string) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(filepath.Dir(path), ".jdtls-source-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(file.Name())
+	defer file.Close()
+	if _, err := file.WriteString(content); err != nil {
+		return err
+	}
+	if err := file.Chmod(0400); err != nil {
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	return os.Rename(file.Name(), path)
+}
+
+// The bridge implements virtual-source support itself, so editors need no setup.
+func enableSourceCapability(request map[string]json.RawMessage) bool {
+	var method string
+	_ = json.Unmarshal(request["method"], &method)
+	if method != "initialize" {
+		return false
+	}
+	decodeObject := func(raw json.RawMessage) map[string]json.RawMessage {
+		var value map[string]json.RawMessage
+		_ = json.Unmarshal(raw, &value)
+		if value == nil {
+			value = make(map[string]json.RawMessage)
+		}
+		return value
+	}
+	params := decodeObject(request["params"])
+	options := decodeObject(params["initializationOptions"])
+	capabilities := decodeObject(options["extendedClientCapabilities"])
+	capabilities["classFileContentsSupport"] = json.RawMessage("true")
+	options["extendedClientCapabilities"], _ = json.Marshal(capabilities)
+	params["initializationOptions"], _ = json.Marshal(options)
+	request["params"], _ = json.Marshal(params)
+	return true
